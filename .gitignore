# --- Gradle / Kotlin -------------------------------------------------------
.gradle/
build/
.kotlin/
local.properties
*.hprof

# --- Android --------------------------------------------------------------
captures/
*.apk.idsig

# --- iOS ------------------------------------------------------------------
# The Xcode project and Info.plist are generated by XcodeGen from
# app/iosApp/project.yml, so they are not checked in.
app/iosApp/*.xcodeproj/
app/iosApp/*.xcworkspace/
app/iosApp/iosApp/Info.plist
xcuserdata/
DerivedData/
*.xcuserstate

# --- Misc -----------------------------------------------------------------
.DS_Store
*.pem

# Release signing material — never commit (.signing/release.keystore backs the
# ANDROID_KEYSTORE_* secrets used by .github/workflows/release.yml).
.signing/
*.keystore
*.jks
